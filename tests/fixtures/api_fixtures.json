{
  "$schema": "lexaloud://fixtures/api/v1",
  "generated_from": "tests/test_daemon_smoke.py, tests/test_platform.py, docs/http-api.md, src/lexaloud/daemon.py:257-319, src/api.rs",
  "base_url": "http://lexaloud",
  "socket": "$XDG_RUNTIME_DIR/lexaloud/lexaloud.sock",
  "headers": {
    "Host": "lexaloud",
    "Connection": "close"
  },
  "cases": [
    {
      "id": "healthz_ok",
      "request": { "method": "GET", "path": "/healthz" },
      "response": {
        "status": 200,
        "body": { "status": "ok" },
        "content_type": "application/json"
      }
    },
    {
      "id": "state_idle_initial",
      "request": { "method": "GET", "path": "/state" },
      "response": {
        "status": 200,
        "body": {
          "state": "idle",
          "queue": [],
          "current_sentence": null,
          "last_error": null,
          "is_warming": false
        }
      }
    },
    {
      "id": "state_speaking_with_queue",
      "request": { "method": "GET", "path": "/state" },
      "state_setup": {
        "state": "speaking",
        "queue": ["sentence 2.", "sentence 3."],
        "current_sentence": "sentence 1."
      },
      "response": {
        "status": 200,
        "body": {
          "state": "speaking",
          "queue": ["sentence 2.", "sentence 3."],
          "current_sentence": "sentence 1.",
          "last_error": null
        }
      }
    },
    {
      "id": "speak_replace_success",
      "request": {
        "method": "POST",
        "path": "/speak",
        "headers": { "Content-Type": "application/json" },
        "body": { "text": "Hello world. This is a test.", "mode": "replace" }
      },
      "response": { "status": 200, "body": { "job_id": 1 } }
    },
    {
      "id": "speak_append_success",
      "request": {
        "method": "POST",
        "path": "/speak",
        "body": { "text": "Append this.", "mode": "append" }
      },
      "response": { "status": 200, "body": { "job_id": 2 } }
    },
    {
      "id": "speak_missing_text_field",
      "request": {
        "method": "POST",
        "path": "/speak",
        "body": { "mode": "replace" }
      },
      "response": { "status": 422, "body": { "detail": "missing field 'text'" } }
    },
    {
      "id": "speak_null_text_rejected",
      "request": {
        "method": "POST",
        "path": "/speak",
        "body": { "text": null, "mode": "replace" }
      },
      "response": { "status": 400, "body": { "detail": "text must be non-null string" } }
    },
    {
      "id": "speak_empty_text_rejected",
      "request": {
        "method": "POST",
        "path": "/speak",
        "body": { "text": "   ", "mode": "replace" }
      },
      "response": { "status": 400, "body": { "detail": "text must be non-empty" } }
    },
    {
      "id": "speak_payload_too_large_413",
      "request": {
        "method": "POST",
        "path": "/speak",
        "headers": { "Content-Type": "application/json" },
        "body": { "text": "<204800+ bytes>", "mode": "replace" },
        "raw_body_size": 300000
      },
      "response": { "status": 413, "body": { "detail": "payload too large" } },
      "notes": "Body size enforced BEFORE JSON parsing; limit 200KB default (config capture.max_bytes)"
    },
    {
      "id": "speak_invalid_json_400",
      "request": {
        "method": "POST",
        "path": "/speak",
        "raw_body": "{ not json",
        "headers": { "Content-Type": "application/json" }
      },
      "response": { "status": 400, "body": { "detail": "invalid JSON" } }
    },
    {
      "id": "pause_when_speaking",
      "request": { "method": "POST", "path": "/pause", "body": {} },
      "pre_state": "speaking",
      "response": { "status": 200, "body": {} },
      "post_state": "paused"
    },
    {
      "id": "pause_when_idle_noop",
      "request": { "method": "POST", "path": "/pause", "body": {} },
      "pre_state": "idle",
      "response": { "status": 200 },
      "post_state": "idle"
    },
    {
      "id": "resume_when_paused",
      "request": { "method": "POST", "path": "/resume", "body": {} },
      "pre_state": "paused",
      "response": { "status": 200 },
      "post_state": "speaking"
    },
    {
      "id": "toggle_speaking_to_paused",
      "request": { "method": "POST", "path": "/toggle", "body": {} },
      "pre_state": "speaking",
      "response": { "status": 200, "body": { "state": "paused" } },
      "post_state": "paused"
    },
    {
      "id": "toggle_paused_to_speaking",
      "request": { "method": "POST", "path": "/toggle", "body": {} },
      "pre_state": "paused",
      "response": { "status": 200, "body": { "state": "speaking" } },
      "post_state": "speaking"
    },
    {
      "id": "stop_clears_queue",
      "request": { "method": "POST", "path": "/stop", "body": {} },
      "pre_state": "speaking",
      "response": { "status": 200 },
      "post_state": "idle",
      "post_queue": []
    },
    {
      "id": "skip_advances_sentence",
      "request": { "method": "POST", "path": "/skip", "body": {} },
      "pre_state": "speaking",
      "pre_queue": ["second.", "third."],
      "response": { "status": 200 },
      "post_current": "second."
    },
    {
      "id": "back_rewinds_one",
      "request": { "method": "POST", "path": "/back", "body": {} },
      "pre_state": "speaking",
      "pre_queue": ["current.", "next."],
      "pre_history": ["prev."],
      "response": { "status": 200 },
      "post_current": "prev."
    },
    {
      "id": "unknown_route_404",
      "request": { "method": "GET", "path": "/unknown" },
      "response": { "status": 404 }
    },
    {
      "id": "get_speak_method_not_allowed",
      "request": { "method": "GET", "path": "/speak" },
      "response": { "status": 405 }
    },
    {
      "id": "concurrent_control_requests_serialized",
      "description": "Concurrent POSTs must not interleave destructive player transitions",
      "requests": [
        { "method": "POST", "path": "/pause", "body": {} },
        { "method": "POST", "path": "/stop", "body": {} },
        { "method": "POST", "path": "/speak", "body": { "text": "concurrent", "mode": "replace" } }
      ],
      "requirement": "Player state machine uses monotonic job ID / mutex; no panic, final state is idle or speaking deterministically"
    }
  ],
  "state_transitions": {
    "idle --speak--> speaking",
    "speaking --pause--> paused",
    "paused --resume--> speaking",
    "speaking --stop--> idle",
    "paused --stop--> idle",
    "speaking --toggle--> paused",
    "paused --toggle--> speaking"
  },
  "error_contract": {
    "nulls_rejected": 400,
    "invalid_json": 400,
    "missing_fields": 422,
    "payload_too_large": 413,
    "unknown_route": 404,
    "method_not_allowed": 405
  },
  "curl_examples": [
    "curl --unix-socket $XDG_RUNTIME_DIR/lexaloud/lexaloud.sock http://lexaloud/healthz",
    "curl --unix-socket $XDG_RUNTIME_DIR/lexaloud/lexaloud.sock http://lexaloud/state",
    "curl --unix-socket $XDG_RUNTIME_DIR/lexaloud/lexaloud.sock -X POST -H 'Content-Type: application/json' -d '{\"text\":\"hello\",\"mode\":\"replace\"}' http://lexaloud/speak"
  ]
}
