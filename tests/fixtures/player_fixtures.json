{
  "$schema": "lexaloud://fixtures/player/v1",
  "generated_from": "tests/test_player_lifecycle.py, tests/test_player_review_regressions.py, src/lexaloud/player.py:84-428, src/player.rs",
  "constants": {
    "ready_queue_depth_default": 3,
    "sub_chunk_seconds": 0.1,
    "inter_sentence_pad_seconds": 0.18,
    "sample_rate": 24000
  },
  "audio_chunk": {
    "type": "AudioChunk { samples: Vec<f32>, sample_rate: u32 }",
    "notes": "CPAL sink converts/resamples only when device requires"
  },
  "cases": [
    {
      "id": "speak_full_play_reaches_idle",
      "description": "5 sentences drains to idle; all audio reaches sink with inter-sentence pads",
      "provider": { "type": "FakeProvider", "synth_delay_ms": 5, "seconds_per_sentence": 0.2 },
      "sink": { "type": "NullSink" },
      "ready_queue_depth": 2,
      "input_sentences": ["sentence 0.", "sentence 1.", "sentence 2.", "sentence 3.", "sentence 4."],
      "actions": [{ "op": "speak", "sentences": 5, "mode": "replace" }],
      "expected": {
        "final_state": "idle",
        "synthesize_calls": 5,
        "samples_received_formula": "5*4800 + 4*4320 = 41280 (sentence 0.2s + pad 0.18s at 24kHz)"
      }
    },
    {
      "id": "speak_replace_cancels_previous_job",
      "description": "New replace cancels old job via monotonic job ID; sink.stop called",
      "provider": { "synth_delay_ms": 20 },
      "ready_queue_depth": 2,
      "steps": [
        { "op": "speak", "sentences": 10, "mode": "replace" },
        { "sleep_ms": 50 },
        { "op": "speak", "sentences": 1, "mode": "replace" },
        { "wait_until": "idle", "timeout_ms": 2000 }
      ],
      "expected": {
        "final_state": "idle",
        "stop_calls_at_least": 1,
        "write_count_grows": true
      }
    },
    {
      "id": "pause_bounds_memory_with_bounded_queue",
      "description": "Pause must not grow ready queue unboundedly; depth 2 bounds memory",
      "provider": { "synth_delay_ms": 5 },
      "ready_queue_depth": 2,
      "steps": [
        { "op": "speak", "sentences": 10, "mode": "replace" },
        { "op": "pause", "immediate": true },
        { "sleep_ms": 100 },
        { "check": "queue_len <= ready_queue_depth + 1 (in-flight)" }
      ],
      "expected": {
        "state": "paused",
        "queue_len_max": 3,
        "notes": "Producer blocks on mpsc send when queue full, bounding memory during any-length pause"
      }
    },
    {
      "id": "pause_resume_toggle",
      "steps": [
        { "op": "speak", "sentences": 5 },
        { "sleep_ms": 20 },
        { "op": "pause" },
        { "check": "state == paused" },
        { "op": "resume" },
        { "check": "state == speaking" },
        { "op": "toggle" },
        { "check": "state == paused" },
        { "op": "toggle" },
        { "check": "state == speaking" }
      ],
      "expected_final": "speaking then idle after drain"
    },
    {
      "id": "stop_resets_to_idle_and_clears_queue",
      "steps": [
        { "op": "speak", "sentences": 5 },
        { "sleep_ms": 20 },
        { "op": "stop" },
        { "check": "state == idle" },
        { "check": "queue empty" },
        { "check": "pause_event set (does not block next job)" }
      ]
    },
    {
      "id": "skip_cuts_current_sentence",
      "description": "Skip aborts current synthesis/playback and advances to next sentence",
      "steps": [
        { "op": "speak", "sentences": ["first long sentence.", "second.", "third."] },
        { "sleep_ms": 15 },
        { "op": "skip" },
        { "check": "current_sentence == 'second.' or queue advanced" }
      ]
    },
    {
      "id": "back_requeues_current_and_previous",
      "description": "Back requeues in-flight sentences and rewinds one sentence",
      "steps": [
        { "op": "speak", "sentences": ["one.", "two.", "three.", "four."] },
        { "sleep_ms": 30 },
        { "op": "skip" },
        { "sleep_ms": 10 },
        { "op": "back" },
        { "check": "current_sentence is previous; queue requeued" }
      ]
    },
    {
      "id": "append_while_speaking_queues",
      "description": "Append mode does not cancel current job; sentences queued",
      "steps": [
        { "op": "speak", "sentences": ["first.", "second."], "mode": "replace" },
        { "sleep_ms": 10 },
        { "op": "speak", "sentences": ["third.", "fourth."], "mode": "append" },
        { "check": "queue contains appended sentences, job_id not cancelled" }
      ]
    },
    {
      "id": "replace_while_append_pending_cancels",
      "steps": [
        { "op": "speak", "sentences": ["a.", "b.", "c."], "mode": "replace" },
        { "sleep_ms": 5 },
        { "op": "speak", "sentences": ["x.", "y."], "mode": "append" },
        { "sleep_ms": 5 },
        { "op": "speak", "sentences": ["new."], "mode": "replace" },
        { "check": "old queue cleared, new job only" }
      ]
    },
    {
      "id": "failed_synthesis_surfaces_last_error",
      "description": "When all synthesis fails, player sets last_error and state idle",
      "provider": { "type": "FakeProvider", "fail_all": true },
      "steps": [
        { "op": "speak", "sentences": ["fail 1.", "fail 2."] },
        { "wait_until": "idle" },
        { "check": "last_error != null" },
        { "check": "state == idle" }
      ]
    },
    {
      "id": "failed_synthesis_partial_continues",
      "description": "When some synthesis fails, successful sentences still play; last_error only if all fail",
      "provider": { "type": "FakeProvider", "fail_indices": [1] },
      "steps": [
        { "op": "speak", "sentences": ["ok 1.", "fail 2.", "ok 3."] },
        { "wait_until": "idle" },
        { "check": "samples_received > 0" },
        { "check": "last_error == null (not all failed)" }
      ]
    },
    {
      "id": "concurrent_control_requests_serialized",
      "description": "Concurrent requests cannot interleave destructive transitions; monotonic job ID protects",
      "concurrency": [
        { "op": "pause" },
        { "op": "stop" },
        { "op": "speak", "sentences": ["concurrent."] }
      ],
      "expected": "no panic, final state deterministic (idle or speaking), job_id monotonic"
    },
    {
      "id": "inter_sentence_silence_180ms",
      "description": "Between sentences, insert 180ms silence to restore natural pause trimmed by Kokoro",
      "provider": { "seconds_per_sentence": 0.5 },
      "expected": {
        "pad_samples": 4320,
        "pad_seconds": 0.18,
        "notes": "Sink receives pad chunk between sentences; last sentence has no trailing pad"
      }
    },
    {
      "id": "sub_chunk_100ms_pause_responsiveness",
      "description": "Audio written in ~100ms blocks; pause checked between blocks => pause within ~100ms",
      "expected": {
        "sub_chunk_seconds": 0.1,
        "sub_chunk_samples": 2400,
        "pause_latency_ms": "~100"
      }
    },
    {
      "id": "device_loss_updates_last_error_and_allows_retry",
      "description": "CPAL device loss sets last_error, stops job safely, next speak retries device creation",
      "sink": { "type": "FakeSink", "fail_on_write": true },
      "steps": [
        { "op": "speak", "sentences": ["test."] },
        { "wait_until": "idle" },
        { "check": "last_error != null" },
        { "sink": { "fail_on_write": false } },
        { "op": "speak", "sentences": ["retry."] },
        { "check": "state == speaking or idle (retry succeeded)" }
      ]
    },
    {
      "id": "bounded_queue_blocks_provider_not_memory",
      "description": "When sink is slow, provider's mpsc send blocks (depth 3), bounding memory",
      "provider": { "synth_delay_ms": 1 },
      "sink": { "type": "SlowSink", "delay_ms": 50 },
      "ready_queue_depth": 3,
      "steps": [
        { "op": "speak", "sentences": 10 },
        { "sleep_ms": 100 },
        { "check": "queue_len <= 3" },
        { "check": "memory stable" }
      ]
    }
  ],
  "state_machine": {
    "states": ["idle", "warming", "speaking", "paused"],
    "transitions": {
      "speak(replace) when idle/warming -> speaking (new job_id)",
      "speak(append) when speaking/paused -> enqueue without new job_id if producer alive",
      "pause when speaking -> paused (clear pause_event, consumer waits)",
      "resume when paused -> speaking (set pause_event)",
      "toggle when speaking -> paused, when paused -> speaking",
      "stop -> idle, clear queues, set pause_event, abort audio stream if needed",
      "skip -> abort current chunk, advance one sentence",
      "back -> requeue current and previous"
    }
  }
}
