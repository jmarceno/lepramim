{
  "$schema": "lepramim://fixtures/cli/v1",
  "generated_from": "tests/test_cli_daemon_down.py, tests/test_bug_report.py, tests/test_setup.py, tests/test_uninstall.py, src/lepramim/cli.py, src/cli.rs",
  "notes": "Only stable user-facing text asserted; dynamic paths/timestamps not asserted. Covers all CLI commands, exit codes, daemon-down errors, --help/--version.",
  "global_flags": [
    {
      "id": "help",
      "args": ["--help"],
      "expected": { "exit": 0, "stdout_contains": ["lepramim", "Usage", "Commands"], "stderr": "" }
    },
    {
      "id": "version",
      "args": ["--version"],
      "expected": { "exit": 0, "stdout_matches": "lepramim 0\\..*" }
    },
    {
      "id": "unknown_command",
      "args": ["unknown-cmd"],
      "expected": { "exit": 2, "stderr_contains": ["unrecognized", "unknown"] }
    }
  ],
  "commands": [
    {
      "id": "app_no_subcommand",
      "args": [],
      "expected": { "exit": 1, "stderr_contains": ["not yet implemented"] }
    },
    {
      "id": "app",
      "args": ["app"],
      "expected": { "exit": 1, "stderr_contains": ["not yet implemented"] },
      "notes": "Until full GUI port, stub returns non-zero not success"
    },
    {
      "id": "tray_alias",
      "args": ["tray"],
      "expected": { "exit": 1 }
    },
    {
      "id": "status_daemon_down",
      "args": ["status"],
      "precondition": "daemon not running (socket missing)",
      "expected": {
        "exit": 3,
        "stderr_contains": [
          "Lepramim daemon is not running or unresponsive",
          "systemctl --user start lepramim.service",
          "lepramim setup"
        ]
      }
    },
    {
      "id": "status_daemon_up",
      "args": ["status"],
      "precondition": "daemon running, socket exists, GET /state returns idle",
      "mock_state": { "state": "idle", "queue": [] },
      "expected": { "exit": 0, "stdout_is_json": true, "stdout_contains": ["idle"] }
    },
    {
      "id": "pause_daemon_down",
      "args": ["pause"],
      "precondition": "daemon not running",
      "expected": { "exit": 3 }
    },
    {
      "id": "resume",
      "args": ["resume"],
      "precondition": "daemon running",
      "mock_endpoint": "/resume",
      "expected": { "exit": 0 }
    },
    {
      "id": "toggle",
      "args": ["toggle"],
      "expected": { "exit": 0 }
    },
    {
      "id": "stop",
      "args": ["stop"],
      "expected": { "exit": 0 }
    },
    {
      "id": "skip",
      "args": ["skip"],
      "expected": { "exit": 0 }
    },
    {
      "id": "back",
      "args": ["back"],
      "expected": { "exit": 0 }
    },
    {
      "id": "speak_selection_no_selection",
      "args": ["speak-selection"],
      "mock_selection": "",
      "expected": {
        "exit": 2,
        "stderr_contains": ["No selection found", "Select text and press"],
        "notification": "Select text first"
      }
    },
    {
      "id": "speak_selection_success",
      "args": ["speak-selection"],
      "mock_selection": "Hello world.",
      "mock_daemon_response": { "status": 200 },
      "expected": { "exit": 0 }
    },
    {
      "id": "speak_selection_max_bytes_flag",
      "args": ["speak-selection", "--max-bytes", "12345"],
      "expected": { "parsed_max_bytes": 12345 }
    },
    {
      "id": "speak_selection_payload_too_large",
      "args": ["speak-selection"],
      "mock_selection_bytes": 300000,
      "mock_daemon_status": 413,
      "expected": {
        "exit": 4,
        "stderr_contains": ["Selection too large"]
      }
    },
    {
      "id": "speak_selection_display_unavailable",
      "args": ["speak-selection"],
      "mock_error": "DisplayUnavailable",
      "expected": { "exit": 5 }
    },
    {
      "id": "speak_clipboard_empty",
      "args": ["speak-clipboard"],
      "mock_clipboard": "",
      "expected": {
        "exit": 2,
        "stderr_contains": ["clipboard is empty", "Ctrl+C"]
      }
    },
    {
      "id": "speak_clipboard_success",
      "args": ["speak-clipboard"],
      "mock_clipboard": "Clipboard text.",
      "expected": { "exit": 0 }
    },
    {
      "id": "download_models_check",
      "args": ["download-models"],
      "precondition": "models missing",
      "expected": { "exit": 1, "stdout_contains": ["missing", "kokoro"] }
    },
    {
      "id": "setup_creates_config",
      "args": ["setup"],
      "precondition": "no config.toml",
      "expected": {
        "exit": 0,
        "creates": ["~/.config/lepramim/config.toml"],
        "stdout_contains": ["Wrote config", "Systemd unit preview"]
      }
    },
    {
      "id": "setup_force_overwrites",
      "args": ["setup", "--force"],
      "expected": { "exit": 0, "force": true }
    },
    {
      "id": "daemon_command_starts",
      "args": ["daemon"],
      "expected": { "exit": 0, "stdout_contains": ["Starting Lepramim daemon"] }
    },
    {
      "id": "uninstall_removes_socket",
      "args": ["uninstall"],
      "precondition": "socket exists",
      "expected": { "exit": 0, "removes": ["$XDG_RUNTIME_DIR/lepramim/lepramim.sock"] }
    },
    {
      "id": "bug_report_redacted_by_default",
      "args": ["bug-report"],
      "precondition": "config exists at /home/alice/.config/lepramim/config.toml",
      "expected": {
        "exit": 0,
        "stdout_contains": ["Lepramim bug report", "Config", "Daemon state"],
        "must_not_contain": ["/home/alice"]
      }
    },
    {
      "id": "bug_report_full_unredacted",
      "args": ["bug-report", "--full"],
      "expected": { "exit": 0, "contains_home": true }
    }
  ],
  "exit_codes": {
    "0": "success",
    "1": "generic error / not yet implemented",
    "2": "no selection / empty",
    "3": "daemon not running",
    "4": "payload too large (413)",
    "5": "display or tool missing / capture failure"
  },
  "stable_text": [
    "Lepramim daemon is not running or unresponsive. Start it with: systemctl --user start lepramim.service",
    "No selection found. Select text and press Meta+R again.",
    "Selection too large for the daemon to accept.",
    "Lepramim: cannot reach display server",
    "Lepramim: capture tool missing"
  ]
}
