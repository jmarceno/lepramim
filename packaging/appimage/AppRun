#!/usr/bin/env bash
set -euo pipefail

HERE="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

# AppImage sets APPIMAGE to the stable path of the image that was launched.
# The setup command uses this to write a systemd unit that executes the
# AppImage itself rather than the temporary mounted AppDir path.
if [[ -n "${APPIMAGE:-}" ]]; then
  export LEXALOUD_APPIMAGE="$APPIMAGE"
fi

# Keep the frozen runtime isolated from user site packages and make bundled
# helper binaries win over same-named host tools when they are present.
export PYTHONNOUSERSITE=1
export PATH="$HERE/usr/bin:$PATH"
export LD_LIBRARY_PATH="$HERE/usr/lib/lexaloud:$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$HERE/usr/lib/lexaloud/lexaloud" "$@"
